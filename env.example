# Copy to .env and fill in. Never commit .env itself.

# --- Server ---
PORT=3000
NODE_ENV=development
# Public base URL of this API (used for the pass webServiceURL). Example:
# PUBLIC_BASE_URL=https://api.example.com
PUBLIC_BASE_URL=
# Service-level API key for section-A routes (dashboard server, scanners).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_API_KEY=your-service-api-key-here

# --- Apple Wallet pass signing (files already provided in certificates/) ---
SIGNER_CERT_PATH=./certificates/signerCert.pem
SIGNER_KEY_PATH=./certificates/signerKey.pem
WWDR_PATH=./certificates/wwdr.pem
SIGNER_KEY_PASSPHRASE=
PASS_TYPE_IDENTIFIER=
APPLE_TEAM_ID=

# --- Database ---
# SUPABASE_URL / SUPABASE_SERVICE_KEY are used for both the Supabase client
# (auth/storage/REST) AND file storage below — needed regardless of which
# database was chosen, since Supabase Storage is used either way.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Only needed if connecting to Postgres directly (e.g. via an ORM) rather
# than through the Supabase client — find this in Supabase → Settings →
# Database:
DATABASE_URL=
# Only if MongoDB was chosen for the app database instead of Supabase Postgres:
MONGODB_URI=

# --- Push notifications (APNs) ---
APNS_KEY_PATH=./certificates/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=

# --- Dashboard auth (fill in whichever provider was chosen) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- File storage (Supabase Storage — uses SUPABASE_URL / SUPABASE_SERVICE_KEY above) ---
SUPABASE_STORAGE_BUCKET=

# --- Optional: GitHub MCP server (only if enabled in opencode.json) ---
GITHUB_PAT=
